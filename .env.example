DB_HOST=postgres
DB_PORT=5432
DB_NAME=events_db
DB_USER=events_user
DB_PASSWORD=change_me

# Optional. Comma-separated CIDRs whose CF-Connecting-IP header is trusted to
# name the real client (used for rate-limit keying and the access log).
# Leave unset for the default — loopback plus the Docker bridge ranges, which
# is how cloudflared on the host reaches the container.
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
