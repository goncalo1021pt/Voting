DB_HOST=postgres
DB_PORT=5432
DB_NAME=events_db
DB_USER=events_user
DB_PASSWORD=change_me

# Optional. Comma-separated CIDRs whose CF-Connecting-IP header is trusted to
# name the real client (used for rate-limit keying and the access log).
# Leave unset for the default — loopback plus the Docker bridge ranges, which
# is how the cloudflared container reaches the backend on the Compose network.
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# Optional. Comma-separated origins allowed to call the API cross-origin.
# Leave unset: the backend serves the frontend on the same origin, so CORS is
# not needed. Set exact origins only — never a wildcard.
# ALLOWED_ORIGINS=https://voting.fontao.net

# Required in production only (the `tunnel` compose profile). Connector token
# for the Cloudflare tunnel named "voting", which serves voting.fontao.net.
# Copy it from the Zero Trust dashboard: Networks -> Tunnels -> voting ->
# Docker. It is a credential — it belongs in .env, never in git.
# TUNNEL_TOKEN=
